APP_NAME=TPVS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=tpvs-postgres
DB_PORT=5432
DB_DATABASE=tpvs
DB_USERNAME=tpvs
DB_PASSWORD=tpvs

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_COOKIE=tpvs_session
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,::1:3000
QUEUE_CONNECTION=database
CACHE_STORE=file
FILESYSTEM_DISK=local

AI_PROVIDER=ollama
AI_OLLAMA_URL=
AI_OLLAMA_MODEL=qwen2.5vl:3b
AI_OLLAMA_TIMEOUT=300

VITE_APP_NAME="${APP_NAME}"
