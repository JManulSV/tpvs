# Docker Compose local development settings. Keep secrets out of version control.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Local development key only; generate a unique key before deployment.
APP_KEY=base64:MAkRbTPzng0K+CAN8QI7qVGfJfAQMemd9pl8s3oxUJ0=

# Laravel browser session and CSRF cookie settings.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_COOKIE=tpvs_session
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,::1:3000,192.168.3.240:3000

# Comma-separated trusted frontend origins. Replace the LAN IP with this server's address.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://192.168.3.240:3000

# Hostnames allowed to request Next.js development assets when accessing over the LAN.
NEXT_ALLOWED_DEV_ORIGINS=192.168.3.240

DB_DATABASE=tpvs
DB_USERNAME=tpvs
DB_PASSWORD=tpvs

# Backend-only asynchronous AI extraction configuration; never expose in frontend settings.
AI_PROVIDER=ollama
AI_OLLAMA_URL=
AI_OLLAMA_MODEL=qwen2.5vl:3b
AI_OLLAMA_TIMEOUT=300
DB_QUEUE_RETRY_AFTER=360

# Temporary local Ollama AI-spike profile (optional; bound to localhost only).
OLLAMA_PORT=11435
