# Docker Compose local development settings. Keep secrets out of version control.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Local development key only; generate a unique key before deployment.
APP_KEY=base64:MAkRbTPzng0K+CAN8QI7qVGfJfAQMemd9pl8s3oxUJ0=

# Laravel browser session and CSRF cookie settings.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_COOKIE=tpvs_session
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,::1:3000

# Trusted public origin used by the Next.js server when forwarding SSR requests.
FRONTEND_ORIGIN=http://localhost:3000

DB_DATABASE=tpvs
DB_USERNAME=tpvs
DB_PASSWORD=tpvs
